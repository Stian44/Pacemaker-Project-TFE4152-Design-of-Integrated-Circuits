    90:  .param VDD_val=0.45
    91:  
    92:  * ==========================================================
    93:  * NIVÅ 1: Grunnceller (Leaf cells)
    94:  * ==========================================================
    95:  .subckt INV A OUT VDD
    96:  MP1 OUT A VDD VDD PMOS L={L_val} W={W_val}
    97:  MN1 OUT A 0   0   NMOS L={L_val} W={W_val}
    98:  .ends INV
    99:  
   100:  .subckt NAND2 A B OUT VDD
   101:  MP1 OUT  A VDD  VDD PMOS L={L_val} W={W_val}
   102:  MP2 OUT  B VDD  VDD PMOS L={L_val} W={W_val}
   103:  MN1 OUT  A MN2D 0   NMOS L={L_val} W={W_val}
   104:  MN2 MN2D B 0    0   NMOS L={L_val} W={W_val}
   105:  .ends NAND2
   106:  
   107:  * ==========================================================
   108:  * NIVÅ 2: Mellomblokker (AND2 og XOR2 bygget av Nivå 1)
   109:  * ==========================================================
   110:  .subckt AND2 A B OUT VDD
   111:  XNAND A B N_MID VDD NAND2
   112:  XINV  N_MID OUT VDD INV
   113:  .ends AND2
   114:  
   115:  .subckt XOR2 A B OUT VDD
   116:  X1 A  B  N1  VDD NAND2
   117:  X2 A  N1 N2  VDD NAND2
   118:  X3 N1 B  N3  VDD NAND2
   119:  X4 N2 N3 OUT VDD NAND2
   120:  .ends XOR2
   121:  
   122:  * ==========================================================
   123:  * NIVÅ 3: MSB-logikk -> MSB = H! * (A!B + AB!) * (AT)!
   124:  * ==========================================================
   125:  .subckt MSB_LOGIC A B H T MSB VDD
   126:  XINV_H   H H_bar VDD INV
   127:  XXOR_AB  A B XOR_AB VDD XOR2
   128:  XNAND_AT A T NAND_AT VDD NAND2
   129:  
   130:  XAND1 H_bar XOR_AB  MID1 VDD AND2
   131:  XAND2 MID1  NAND_AT MSB  VDD AND2
   132:  .ends MSB_LOGIC
   133:  
   134:  * ==========================================================
   135:  * TOPPNIVÅ: Testbench for alle 16 tilstander (512 Hz-takt)
   136:  * ==========================================================
   137:  VDD VDD 0 {VDD_val}
   138:  
   139:  * 4-bits binærteller gjennom alle 16 kombinasjoner (0000 til 1111)
   140:  VT T 0 PULSE(0 {VDD_val} 2m  1u 1u 2m  4m)
   141:  VH H 0 PULSE(0 {VDD_val} 4m  1u 1u 4m  8m)
   142:  VB B 0 PULSE(0 {VDD_val} 8m  1u 1u 8m  16m)
   143:  VA A 0 PULSE(0 {VDD_val} 16m 1u 1u 16m 32m)
   144:  
   145:  * Instansier MSB-blokken
   146:  XMSB A B H T MSB VDD MSB_LOGIC
   147:  
   148:  
   149:  .tran 10U 32m

